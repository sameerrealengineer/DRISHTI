# Copy to .env. Defaults run fully offline in DEMO MODE (PRD §12, §13.3).
DRISHTI_MODE=demo            # demo | live
DATABASE_URL=postgresql+psycopg://drishti:drishti@db:5432/drishti
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me
PHONE_PEPPER=change-me-pepper
PHONE_ENC_KEY=               # base64 32-byte AES key (required in live; derived from JWT_SECRET in demo)
S3_ENDPOINT=http://minio:9000
S3_BUCKET=drishti
S3_KEY=minio
S3_SECRET=minio123
OPEN_METEO_BASE=https://api.open-meteo.com/v1/forecast
SACHET_RSS_URL=              # Odisha CAP RSS (set in live)
FCM_CREDENTIALS_JSON=        # empty in demo -> simulated push
SMS_PROVIDER=simulated       # simulated | msg91 | gupshup | twilio
WHATSAPP_PROVIDER=simulated
GEE_SERVICE_ACCOUNT_JSON=    # live satellite only
AUTO_ASSIGN_SECONDS=300      # demo mode always uses 6
DEFAULT_LANGUAGE=or
SIM_SECONDS_PER_HOUR=20      # demo clock: real seconds per sim hour at 1x (16x -> 0.8 h/s)
